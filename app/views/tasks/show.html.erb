<div class="container py-4">
  <h1 class="mb-3">
    <% if @task.completed %>
      <i class="fa-regular fa-square-check text-success me-2"></i>
    <% else %>
      <i class="fa-regular fa-square text-muted me-2"></i>
    <% end %>
    <%= @task.title %>
  </h1>

  <p class="lead"><%= @task.details %></p>

  <%= link_to "Edit", edit_task_path(@task), class: "btn btn-outline-secondary" %>
  <%= link_to "Back to tasks", tasks_path, class: "btn btn-link" %>
</div>
